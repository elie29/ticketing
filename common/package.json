{
  "name": "@elie29/ticketing-common",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Ticketing commons",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build/**/*"
  ],
  "scripts": {
    "clean": "node -e \"const fs = require('node:fs'); const path = require('node:path'); if (fs.existsSync('build')) for (const name of fs.readdirSync('build')) fs.rmSync(path.join('build', name), { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../vitest.config.mts --project common",
    "test:watch": "vitest --config ../vitest.config.mts --project common",
    "test:ci": "npm run build && npm test",
    "test:broker": "npm run build && vitest run --config ../vitest.config.mts --project common-broker"
  },
  "keywords": [
    "ticketing",
    "common"
  ],
  "author": "Elie NEHME",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "cookie-session": "^2.1.1",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "@nats-io/transport-node": "^3.4.0",
    "@nats-io/jetstream": "^3.4.0"
  }
}
